# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large Raw Datasets (preserve preprocessed pipeline configs and scripts)
data/
*.pt
*.pth
*.tfrecord
*.parquet

# Ranker / trainer weights (keep training.log metrics.json config.json)
checkpoints/**/*.pth

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# IDE & OS specific
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
